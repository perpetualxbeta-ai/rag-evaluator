# Which models to use: "ollama" (free, local) or "openai" (paid API)
LLM_PROVIDER=ollama

# --- Ollama (LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI (LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-...

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/rag
# Defaults to rag_eval_<provider>, so OpenAI and Ollama indexes never mix
# PGVECTOR_COLLECTION=rag_eval_ollama

# --- Model overrides (optional; defaults depend on LLM_PROVIDER) ---
#   ollama: nomic-embed-text / qwen2.5:7b for all three roles
#   openai: text-embedding-3-small / gpt-4o-mini / gpt-4o-mini / gpt-4o
# EMBEDDING_MODEL=
# GENERATOR_MODEL=
# RAG_MODEL=
# JUDGE_MODEL=
